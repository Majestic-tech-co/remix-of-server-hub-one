# Browser-safe (shipped in the bundle). Publishable/anon key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Cloudflare Turnstile SITE key (public). Leave empty to disable the widget locally.
VITE_TURNSTILE_SITE_KEY=

# Server-only (set in the hosting dashboard, NEVER prefix with VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
