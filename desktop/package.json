{
  "name": "fleet-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Fleet desktop app: the Fleet web app plus direct SSH from your own device",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "test": "echo \"run tests from the repository root: npm test\"",
    "smoke": "npm run build && node smoke/smoke.mjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.majestic.fleet",
    "productName": "Fleet",
    "copyright": "Copyright © Majestic Tech",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Fleet-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fleet",
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "author": "Majestic Tech"
}
