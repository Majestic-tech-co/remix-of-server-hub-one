{
  "name": "fleet-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Fleet desktop app: the Fleet web app plus direct SSH from your own device",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && npx --yes electron-builder",
    "test": "echo \"run tests from the repository root: npm test\""
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.majestic.fleet",
    "productName": "Fleet",
    "files": [
      "dist/**",
      "package.json",
      "node_modules/**",
      "!node_modules/**/{test,tests,docs}/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
